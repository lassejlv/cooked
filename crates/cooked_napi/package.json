{
  "name": "@cookedjs/binding",
  "version": "0.1.1",
  "description": "Native Cooked compiler bindings (napi-rs).",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "cooked-binding",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  },
  "license": "MIT",
  "author": "Lasse Vestergaard",
  "repository": {
    "type": "git",
    "url": "https://github.com/lassejlv/cooked"
  },
  "keywords": [
    "cooked",
    "compiler",
    "reactive",
    "vite",
    "ssr",
    "framework"
  ],
  "publishConfig": {
    "access": "public"
  }
}
