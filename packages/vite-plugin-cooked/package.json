{
  "name": "@cookedjs/vite-plugin-cooked",
  "version": "0.1.0",
  "description": "Vite plugin for the Cooked language (.ck).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "default": "./client.d.ts"
    }
  },
  "files": [
    "dist",
    "client.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@cookedjs/binding": "workspace:*",
    "@cookedjs/cooked": "workspace:*"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "license": "MIT",
  "author": "Lasse Vestergaard",
  "repository": {
    "type": "git",
    "url": "https://github.com/lassejlv/cooked"
  },
  "keywords": [
    "cooked",
    "compiler",
    "reactive",
    "vite",
    "ssr",
    "framework"
  ]
}
